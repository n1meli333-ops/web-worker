# ==================== DATABASE ====================
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ytagent

# ==================== ADSPOWER ====================
# URL to AdsPower Local API (running on Windows VPS)
ADSPOWER_URL=http://YOUR_WINDOWS_VPS_IP:50325

# ==================== TELEGRAM BOT ====================
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Your personal chat ID (send /start to your bot, then check)
TELEGRAM_CHAT_ID=your_chat_id_here

# ==================== ASSEMBLYAI ====================
# Optional: if empty, will use browser automation
ASSEMBLYAI_API_KEY=your_api_key_here

# ==================== FLOW (VIDEO GENERATION) ====================
# URL to Flow script page (Veo 3.1 / Nano Banana Pro)
FLOW_SCRIPT_URL=https://your-flow-script-url.com
# Optional: separate URL for image generation
FLOW_IMAGE_URL=
# Optional: directory where Flow saves generated files
FLOW_OUTPUT_DIR=

# ==================== ELEVENLABS ====================
# URL to the third-party ElevenLabs site
ELEVENLABS_SITE_URL=https://elevenlabs.io/app/speech-synthesis

# ==================== AGENT ====================
# Cron schedule for checking channels (default: every 2 hours)
SCHEDULER_CRON=0 */2 * * *
# Directory for storing generated files
OUTPUT_DIR=./output

# ==================== SERVER ====================
PORT=3002
NODE_ENV=production
